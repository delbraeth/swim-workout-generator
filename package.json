{
  "name": "setforge",
  "version": "1.0.0",
  "description": "SetForge — swim workout generator + week-view planner with coach-group workflows. Serves the SPA + an Express/MariaDB API.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "rm -rf public/assets/chunks && esbuild src/main.jsx --bundle --outdir=public/assets --entry-names=app --chunk-names=chunks/[name]-[hash] --splitting --format=esm --jsx=transform --jsx-factory=React.createElement --jsx-fragment=React.Fragment --minify --target=es2019",
    "build:dev": "rm -rf public/assets/chunks && esbuild src/main.jsx --bundle --outdir=public/assets --entry-names=app --chunk-names=chunks/[name]-[hash] --splitting --format=esm --jsx=transform --jsx-factory=React.createElement --jsx-fragment=React.Fragment --sourcemap --target=es2019",
    "smoke": "node tools/jsdom_smoke.mjs",
    "freevars": "node tools/freevars.mjs",
    "checkserver": "esbuild server.js --bundle --platform=node --format=esm --packages=external --outfile=/dev/null --log-level=error"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.0.0",
    "mariadb": "^3.5.2",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
