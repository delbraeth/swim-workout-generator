<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEBUG-ONLY Info.plist. Wired in via INFOPLIST_FILE on the Debug build
  configuration only (see SetForgeApp.xcodeproj). GENERATE_INFOPLIST_FILE is
  still YES, so Xcode merges the auto-generated keys (scene manifest, launch
  screen, orientations, etc.) on top of this file at build time.

  It allows plain-HTTP requests to a local backend (`node server.js` on :8080)
  from the Simulator (scoped to localhost), and registers the Google Sign-In
  URL scheme. Release uses Info-Release.plist (URL scheme only, no ATS exception).
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.954573648973-po6gk9nrdoarq8s7ncev7cmet5dmnkoc</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
